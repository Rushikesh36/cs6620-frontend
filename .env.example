# Copy to .env.local (gitignored) to change how the mock backend behaves.
# `npm run dev:mock` turns the mock on; without it the app calls the real API from public/config.json.

# Turn the in-browser mock API on (the scripts dev:mock and build:mock set this for you).
NEXT_PUBLIC_USE_MOCKS=true

# Login token lifetime in minutes (default 60). Use 2 to test expiry and the "expires soon" banner.
# NEXT_PUBLIC_MOCK_TOKEN_MINUTES=2

# Share of normal scans that end FAILED, 0 to 1 (default 0.2). Use 0 for always-successful scans.
# NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# Answer about 1 in 5 API calls (except login) with a 500, to test error states.
# NEXT_PUBLIC_MOCK_RANDOM_500=true

# Speed up scan stages: 0.1 makes a 20 second scan take 2 seconds (default 1).
# NEXT_PUBLIC_MOCK_TIME_SCALE=0.1

# Make GET /targets return an empty list, to test the "no test apps" state.
# NEXT_PUBLIC_MOCK_NO_TARGETS=true
